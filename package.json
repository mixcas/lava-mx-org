{
  "name": "lava-mx-org",
  "version": "1.0.0",
  "private": true,
  "description": "lava-mx.org — Eleventy static site migrated from Cargo",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve",
    "preview": "node scripts/dev-server.mjs",
    "images:rebuild": "rm -rf _site/img && eleventy",
    "clean": "rm -rf _site",
    "backup": "node scripts/backup.mjs",
    "extract": "node scripts/extract.mjs",
    "fetch-assets": "node scripts/fetch-assets.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^7.0.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "node-html-parser": "^9.0.4",
    "turndown": "^7.2.4"
  }
}
