{#
	The title and the bilingual text shared by both project layouts, so the
	markup lives in one place instead of being repeated per variant. Import both
	macros — `{% from "partials/project-content.njk" import projectTitle,
	projectBody %}` — and call them; the layouts keep their own structure.

	projectTitle(project, heading, linked)
		A heading at the surface's level ("h1" on a project page, "h2" on a
		listing page). On a listing surface the title links to its project page.

	projectBody(text)
		The Spanish rich text, then — only when the English field is filled —
		the divider and the English rich text. Editors leave the English field
		empty instead of typing a divider.

	Kept inline (no trailing newline) so importing templates control their own
	whitespace.
#}
{% from "partials/divider.njk" import divider -%}
{% macro projectTitle(project, heading, linked) %}<{{ heading }} class="project-header__title">{% if linked %}<a href="{{ project.url | url }}">{{ project.title }}</a>{% else %}{{ project.title }}{% endif %}</{{ heading }}>{% endmacro -%}
{% macro projectBody(text) %}<div class="project-body">{{ text.spanish | md | safe }}{% if text.english %}{{ divider() }}
			{{ text.english | md | safe }}{% endif %}</div>{% endmacro -%}
