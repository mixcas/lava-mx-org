{#
	The title and the body shared by both project layouts, so the markup lives
	in one place instead of being repeated per variant. Import both macros —
	`{% from "partials/project-content.njk" import projectTitle, projectBody %}`
	— and call them; the layouts keep their own structure.

	projectTitle(project, heading, linked)
		A heading at the surface's level ("h1" on a project page, "h2" on a
		listing page). On a listing surface the title links to its project page
		in the surface's language (the view model resolves the URL).

	projectBody(text)
		One rich text per page: the body of the page's language version. An
		English page of a project with no English text shows the Spanish body,
		and `text.language` marks that block with its own language attribute, so
		a screen reader announces it as Spanish. Nothing is drawn between the
		texts: there is only ever one (ADR-0002).

	Kept inline (no trailing newline) so importing templates control their own
	whitespace.
#}
{% macro projectTitle(project, heading, linked) %}<{{ heading }} class="project-header__title">{% if linked %}<a href="{{ project.url | url }}">{{ project.title }}</a>{% else %}{{ project.title }}{% endif %}</{{ heading }}>{% endmacro -%}
{% macro projectBody(text) %}<div class="project-body"{% if text.fallback %} lang="{{ text.language }}"{% endif %}>{{ text.body | md | safe }}</div>{% endmacro -%}
