---
layout: base.njk
---
{% if variant == "three-column" %}
	<article class="project project--three-column">
		<div class="project-three">
			<div class="project-three__col">
				<div class="project-header__title">{{ title }}</div>
				<div class="project-gallery">
					{% for m in media_left %}{% picture m.src %}{% endfor %}
				</div>
			</div>
			<div class="project-three__col">
				<div>{{ venue | mdInline | safe }}</div>
				<div class="project-gallery">
					{% for m in media_middle %}{% picture m.src %}{% endfor %}
				</div>
			</div>
			<div class="project-three__col">
				<div>{{ dates | mdInline | safe }}</div>
				<div class="project-body">{{ text | md | safe }}</div>
			</div>
		</div>
	</article>
{% else %}
	<article class="project">
		<header class="project-header">
			<div class="project-header__title">{{ title }}</div>
			<div>{{ venue | mdInline | safe }}</div>
			<div>{{ dates | mdInline | safe }}</div>
		</header>
		<div class="project-main">
			<div class="project-gallery" data-columns="{{ gallery_columns }}">
				{% for m in media %}
					{% if m.video %}
						<video class="project-video" src="{{ ('/assets/videos/' + m.src) | url }}"{% if m.poster %} poster="{% imageUrl m.poster, 1200 %}"{% endif %}{% if m.autoplay %} autoplay{% endif %}{% if m.loop %} loop{% endif %}{% if m.muted %} muted{% endif %} playsinline preload="metadata"></video>
					{% else %}
						{% picture m.src %}
					{% endif %}
				{% endfor %}
			</div>
			<div class="project-body">{{ text | md | safe }}</div>
		</div>
	</article>
{% endif %}
