{#
	One layout, two language versions (ADR-0002).

	The page language is derived from the route the page was built at, never
	from content: `src/_data/languages.json` declares the languages, and the
	`languageRoutes` collection is the registry of the routes Eleventy actually
	built, per language. From those come `<html lang>`, the chrome's language
	(`site[<language code>]`), the Language link to the same route in the other
	language, and the hreflang / `og:locale` metadata.

	To give a page an English version, paginate it over `languages` the way
	`src/index.njk` does (`resolve: values`, a permalink built from the language
	prefix, and `addAllPagesToCollections: true` so the registry sees both
	pages). Nothing here needs editing: the Language link, the hreflang set and
	the sitemap alternates appear for that route in the same build, and a page
	that exists in one language only keeps advertising just that one.
#}
{%- set pageLanguages = page.url | languageAlternates(collections.languageRoutes) -%}
{%- set language = pageLanguages.language -%}
{%- set pageTitle = title or projectView.title -%}
{#- The description a page draws from its own text: the body of the page's
    language version, or the `description` a page computes from its own text
    (the About page's biography). Either is that language version's own — the
    Spanish one only when that version is untranslated — and never the other
    language's text (ADR-0002). It is Markdown, so it is rendered, stripped and
    truncated the way a project body is; a page with neither falls back to the
    site description, which is the settings' own text in that language. -#}
{%- set ownText = projectView.text.body or description -%}
{% if ownText %}{% set metaDescription = ownText | md | striptags | replace('\n', ' ') | truncate(160) %}{% else %}{% set metaDescription = site[language.code].description %}{% endif %}
{% if pageTitle and pageTitle != site.title %}{% set metaTitle = pageTitle + ' — ' + site.title %}{% else %}{% set metaTitle = site.title %}{% endif %}
<!doctype html>
<html lang="{{ language.code }}">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
		<title>{{ metaTitle }}</title>
		<meta name="description" content="{{ metaDescription }}">
		<link rel="canonical" href="{{ siteUrl }}{{ page.url | url }}">
		{% for alternate in pageLanguages.alternates %}<link rel="alternate" hreflang="{{ alternate.hreflang }}" href="{{ siteUrl }}{{ alternate.url | url }}">
		{% endfor %}<meta property="og:site_name" content="{{ site.title }}">
		<meta property="og:type" content="website">
		<meta property="og:locale" content="{{ language.locale }}">
		{% if pageLanguages.languageLink %}<meta property="og:locale:alternate" content="{{ pageLanguages.languageLink.locale }}">
		{% endif %}<meta property="og:title" content="{{ metaTitle }}">
		<meta property="og:description" content="{{ metaDescription }}">
		<meta property="og:url" content="{{ siteUrl }}{{ page.url | url }}">
		{% if heroImage %}
			<meta property="og:image" content="{{ siteUrl }}{% imageUrl heroImage, 1200 %}">
		{% else %}
			<meta property="og:image" content="{{ siteUrl }}{{ '/assets/images/lava-logo.png' | url }}">
		{% endif %}
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content="{{ metaTitle }}">
		<meta name="twitter:description" content="{{ metaDescription }}">
		{% if heroImage %}
			<meta name="twitter:image" content="{{ siteUrl }}{% imageUrl heroImage, 1200 %}">
		{% else %}
			<meta name="twitter:image" content="{{ siteUrl }}{{ '/assets/images/lava-logo.png' | url }}">
		{% endif %}
		<link rel="preload" as="font" type="font/woff2" href="{{ '/assets/fonts/instrument-sans-latin-wght-normal.woff2' | url }}" crossorigin>
		{% if heroImage %}{% imagePreload heroImage %}{% endif %}
		<link rel="icon" href="{{ '/assets/favicon.ico' | url }}" sizes="any">
		<link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}">
	</head>
	<body>
		<header class="site-header">
			<nav class="site-nav" aria-label="{{ site[language.code].navLabel }}">
				<a class="site-nav__item" href="{{ site[language.code].nav.about.route | languageRouteUrl(language) | url }}">{{ site[language.code].nav.about.label }}</a>
				<a class="site-nav__item" href="mailto:{{ site.contactEmail }}">{{ site.contactName }}</a>
				<a class="site-nav__item" href="{{ site[language.code].nav.projects.route | languageRouteUrl(language) | url }}"><svg class="site-nav__icon" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"><path d="M2 4.5h12M2 8h12M2 11.5h12"/></svg>{{ site[language.code].nav.projects.label }}</a>
				{#- The Language link: one plain anchor to the same page in the other
				    language — no script, no cookie, no auto-detection. It is rendered
				    only when that page was built, and names its language in that
				    language. -#}
				{% if pageLanguages.languageLink %}<a class="site-nav__item site-nav__language" href="{{ pageLanguages.languageLink.url | url }}" hreflang="{{ pageLanguages.languageLink.code }}" lang="{{ pageLanguages.languageLink.code }}">{{ pageLanguages.languageLink.label }}</a>{% endif %}
				<div class="site-nav__item site-nav__email">{{ site.email }}</div>
			</nav>
			<div class="site-brand">
				<a class="site-brand__link" href="{{ 'home' | languageRouteUrl(language) | url }}" aria-label="{{ site.title }}">
					<img src="{{ '/assets/images/lava-logo.png' | url }}" alt="{{ site.title }}" width="1400" height="551">
				</a>
			</div>
		</header>
		<main class="site-main">
			<div class="page-content">{{ content | safe }}</div>
		</main>
		<footer class="site-footer">
			<div class="site-footer__inner">
				<span>{{ site[language.code].footer.copyright }}</span>
				<span>{{ site[language.code].footer.city }}</span>
				<span>{{ site[language.code].footer.instagram }}</span>
			</div>
		</footer>
	</body>
</html>
