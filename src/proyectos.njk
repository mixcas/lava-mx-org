---
layout: base.njk
title: Proyectos
permalink: /proyectos/
---
{% for item in collections.pastProjects %}
{% set d = item.data %}
{% if d.variant == "three-column" %}
	<article class="project project--three-column">
		<div class="project-three">
			<div class="project-three__col">
				<div class="project-header__title"><a href="{{ item.url | url }}">{{ d.title }}</a></div>
				<div class="project-gallery">
					{% for m in d.media_left %}{% picture m.src %}{% endfor %}
				</div>
			</div>
			<div class="project-three__col">
				<div>{{ d.venue | mdInline | safe }}</div>
				<div class="project-gallery">
					{% for m in d.media_middle %}{% picture m.src %}{% endfor %}
				</div>
			</div>
			<div class="project-three__col">
				<div>{{ d.dates | mdInline | safe }}</div>
				<div class="project-body">{{ d.text | md | safe }}</div>
			</div>
		</div>
	</article>
{% else %}
	<article class="project">
		<header class="project-header">
			<div class="project-header__title"><a href="{{ item.url | url }}">{{ d.title }}</a></div>
			<div>{{ d.venue | mdInline | safe }}</div>
			<div>{{ d.dates | mdInline | safe }}</div>
		</header>
		<div class="project-main">
			<div class="project-gallery" data-columns="{{ d.gallery_columns }}">
				{% for m in d.media %}
					{% if m.video %}
						<video class="project-video" src="{{ ('/assets/videos/' + m.src) | url }}"{% if m.poster %} poster="{% imageUrl m.poster, 1200 %}"{% endif %}{% if m.autoplay %} autoplay{% endif %}{% if m.loop %} loop{% endif %}{% if m.muted %} muted{% endif %} playsinline preload="metadata"></video>
					{% else %}
						{% picture m.src %}
					{% endif %}
				{% endfor %}
			</div>
			<div class="project-body">{{ d.text | md | safe }}</div>
		</div>
	</article>
{% endif %}
{% endfor %}
