{#
	The 404 page (ADR-0002). It is the one page that cannot know which language
	version was wanted — the requested URL names none — so it is the only page
	that speaks both: the page's language is Spanish (the root of the site, hence
	the Spanish chrome), and its text carries one short line per language, each
	marked with its own `lang` so a screen reader pronounces it correctly, and
	each linking to the homepage of that language's tree. Every other page
	carries one language's text only.

	The lines are keyed by language code and rendered by iterating
	`src/_data/languages.json`, so the links follow the declared prefixes and the
	deployment path prefix instead of naming a language tree here.
#}
{%- set notFound = {
	es: { message: "La página que buscas no existe.", link: "Volver al inicio" },
	en: { message: "The page you are looking for does not exist.", link: "Back to the start" }
} -%}
<article class="project">
	<header class="project-header">
		<div class="project-header__title">404</div>
		<div></div>
		<div></div>
	</header>
	<div class="project-main">
		<div class="project-body">
			{%- for language in languages %}
			<p lang="{{ language.code }}">{{ notFound[language.code].message }} <a href="{{ (language.prefix + '/') | url }}">{{ notFound[language.code].link }}</a></p>
			{%- endfor %}
		</div>
	</div>
</article>
